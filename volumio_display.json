  // Optionally save this file as:
  // /etc/volumio_display.json
  //
  // Edit with:
  // sudo nano /etc/volumio_display.json
  // remove all comments from json before you save

{
  "display":{
    "fb_path":"/dev/fb0",
    "width":480,
    "height":320,
    "clock_type":"12h",
    "cpu_temp_unit":"C"
  },
  "volumio":{
    "wait_timeout_seconds":8.0
  },
  "debug":{
    "enabled":false,
    "log_path":"/var/log/volumio_fbd.log",
    "max_bytes":262144
  }
}
